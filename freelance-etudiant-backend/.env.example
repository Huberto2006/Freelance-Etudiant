# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Base de donnees PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=huberto
DB_PASSWORD=changez-moi
DB_DATABASE=freelance_etudiant_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT (generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=CHANGEZ_MOI
JWT_EXPIRES_IN=2d
JWT_REFRESH_SECRET=CHANGEZ_MOI_AUSSI
JWT_REFRESH_EXPIRES_IN=7d

# CORS / URL frontend (liens dans les emails)
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ============================================================
# EMAILS (SMTP reel via Nodemailer)
# Exemples : Gmail (app password), Brevo, Mailgun, Mailtrap (tests).
# Si vide : les emails sont journalises en console (mode dev).
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KIANJA <no-reply@kianja.mg>

# ============================================================
# PAIEMENT MVola (Telma Madagascar) - https://developer.mvola.mg
# Compte developpeur -> Application -> abonnement "MVola API"
# -> consumer key/secret + apiKey ; partnerId = numero marchand.
# Sandbox : MVOLA_BASE_URL=https://devapi.mvola.mg
# Production : MVOLA_BASE_URL=https://api.mvola.mg
# Si vide : le paiement MVola en ligne repond 503 (pas de simulation).
# ============================================================
MVOLA_BASE_URL=https://devapi.mvola.mg
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_API_KEY=
MVOLA_PARTNER_ID=
MVOLA_PARTNER_NAME=KIANJA
MVOLA_USER_ACCOUNT_ORIGIN=034

# Secret HMAC-SHA256 des webhooks de paiement (generer aleatoirement)
PAIEMENT_WEBHOOK_SECRET=CHANGEZ_MOI
