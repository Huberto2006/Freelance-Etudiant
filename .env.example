# Copier le .env prepare avec ses secrets, pas ce modele tel quel.
# Ce fichier est lu par Docker Compose a la racine du projet.
COMPOSE_PROJECT_NAME=kianja
TZ=Indian/Antananarivo

# Seul port publie sur l'hote ; absent de la liste des ports reserves.
# Si vous le changez, modifier aussi deploy/nginx/kianja.arato.mg.conf.
APP_HTTP_PORT=3210

# Domaine public : HTTP au premier deploiement, puis HTTPS apres Certbot.
FRONTEND_URL=http://kianja.arato.mg
# URL publique https de l'API, AVEC le prefixe global (ex. https://kianja.arato.mg/api/v1),
# sans slash final. Obligatoire en production pour le paiement Papi : l'URL de
# notification envoyee a Papi est <API_PUBLIC_URL>/paiements/webhook/papi, et nginx
# n'achemine que /api/ vers le backend.
API_PUBLIC_URL=
CORS_ORIGIN=http://kianja.arato.mg,https://kianja.arato.mg
# URL relative : REST, uploads et Socket.IO suivent HTTP ou HTTPS du navigateur.
NEXT_PUBLIC_API_URL=/api/v1

# PostgreSQL est interne a Docker ; aucun port PostgreSQL publie sur l'hote.
DB_DATABASE=kianja_db
DB_USERNAME=kianja
DB_PASSWORD=GENERER_UN_SECRET_DB
DB_LOGGING=false

# Secrets independants : generer avec openssl rand -hex 48.
JWT_SECRET=GENERER_UN_SECRET_JWT
JWT_EXPIRES_IN=2d
JWT_REFRESH_SECRET=GENERER_UN_SECRET_REFRESH
JWT_REFRESH_EXPIRES_IN=7d
PAIEMENT_WEBHOOK_SECRET=GENERER_UN_SECRET_WEBHOOK

# Connexion Google et protection anti-robot Turnstile.
# Le Client ID Google est public ; la cle secrete Turnstile reste privee.
GOOGLE_CLIENT_ID=VOTRE_CLIENT_ID.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
TURNSTILE_SECRET_KEY=VOTRE_CLE_SECRETE_TURNSTILE
NEXT_PUBLIC_TURNSTILE_SITE_KEY=VOTRE_CLE_DE_SITE_TURNSTILE

# Compte administrateur créé/réinitialisé uniquement par le seeder explicite.
ADMIN_EMAIL=admin@kianja.mg
ADMIN_PASSWORD=GENERER_UN_MOT_DE_PASSE_ADMIN_D_AU_MOINS_12_CARACTERES

# Configuration ARATO. Le mot de passe reel reste uniquement dans .env.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.arato.mg
MAIL_PORT=587
MAIL_USERNAME=support@arato.mg
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@arato.mg
MAIL_FROM_NAME=ARATO
CONTACT_MAIL_TO=support@arato.mg

# Correspondances vers les variables attendues par NestJS/Nodemailer.
# Compose developpe ces references ; ne pas entourer les aliases d'apostrophes.
# Le port 587 utilise STARTTLS avec SMTP_SECURE=false.
SMTP_HOST=${MAIL_HOST}
SMTP_PORT=${MAIL_PORT}
SMTP_SECURE=false
SMTP_USER=${MAIL_USERNAME}
SMTP_PASS=${MAIL_PASSWORD}
MAIL_FROM="${MAIL_FROM_NAME} <${MAIL_FROM_ADDRESS}>"

# Paiement reel MVola : remplir avec les acces marchands de production.
# Sans ces acces, le paiement MVola en ligne repond 503.
# Pour un compte sandbox, utiliser https://devapi.mvola.mg.
MVOLA_BASE_URL=https://api.mvola.mg
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_API_KEY=
MVOLA_PARTNER_ID=
MVOLA_PARTNER_NAME=KIANJA
MVOLA_USER_ACCOUNT_ORIGIN=034

# Paiement Papi (papi.mg) : renseigner l'URL API, la cle API et le secret
# webhook fournis par Papi. Sans URL et cle API, le paiement Papi reste inactif.
# Les chemins, l'en-tete d'authentification et la devise sont configurables
# selon les parametres communiques par Papi.
PAPI_BASE_URL=
PAPI_API_KEY=
PAPI_WEBHOOK_SECRET=
PAPI_CREATE_PATH=/payment-links
# Lecture du statut : laisser vide (defaut officiel GET /payment-links/{reference}).
# Placeholders pris en charge : {paymentReference} et {reference}.
PAPI_STATUS_PATH=
PAPI_AUTH_HEADER=Token
# Vide : la cle est envoyee brute (pas de « Bearer »).
PAPI_AUTH_SCHEME=
PAPI_CURRENCY=MGA
PAPI_SIGNATURE_HEADER=x-papi-signature
# PAPI_WEBHOOK_SECRET : copier EN ENTIER le secret du tableau de bord Papi
# (onglet Developpeur), prefixe `pwhsec_` inclus.
